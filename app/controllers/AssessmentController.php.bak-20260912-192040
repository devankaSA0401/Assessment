<?php
function new_assessment(){ $title='New Assessment'; ob_start(); require __DIR__.'/../views/assessments/new.php'; $content=ob_get_clean(); require __DIR__.'/../views/layout.php'; }
function create_assessment(){ verify_csrf(); $db=Database::get(); $stmt=$db->prepare('INSERT INTO assessments(vendor_name,assessor_name,assessment_date,reference,notes,status,created_by) VALUES(?,?,?,?,?,?,?)'); $stmt->execute([trim($_POST['vendor_name']),trim($_POST['assessor_name']),$_POST['assessment_date'],trim($_POST['reference']??''),trim($_POST['notes']??''),'In Progress',current_user()['id']]); $id=(int)$db->lastInsertId(); flash('success','Assessment berhasil dibuat.'); redirect('assessments/'.$id); }
function assessment_data(int $id): array {
 $db=Database::get(); $st=$db->prepare('SELECT * FROM assessments WHERE id=?'); $st->execute([$id]); $assessment=$st->fetch(); if(!$assessment){http_response_code(404);exit('Assessment not found');}
 $parameters=$db->query('SELECT * FROM parameters ORDER BY sort_order')->fetchAll();
 foreach($parameters as &$p){$q=$db->prepare('SELECT * FROM controls WHERE parameter_id=? ORDER BY sort_order');$q->execute([$p['id']]);$p['controls']=$q->fetchAll();}
 $q=$db->prepare('SELECT * FROM assessment_answers WHERE assessment_id=?');$q->execute([$id]);$answers=[];foreach($q as $a)$answers[$a['control_id']]=$a;
 return [$assessment,$parameters,$answers];
}
function calculate_score(array $parameters,array $answers): array {
 $counts=['Compliant'=>0,'Partially Compliant'=>0,'Non-Compliant'=>0,'N/A'=>0];$final=0;$critical=0;$ps=[];$answered=0;
 foreach($parameters as $p){$sum=0;$app=0;foreach($p['controls'] as $c){$s=$answers[$c['id']]['status']??null;if($s){$counts[$s]++;if($s!=='N/A'){$app++;$answered++;$sum+=status_score($s);}if($c['critical'] && in_array($s,['Partially Compliant','Non-Compliant'],true))$critical++;}}$score=$app?($sum/$app):0;$weighted=$totalWeight>0 ? $score*((float)$p['weight']/$totalWeight) : 0;$final+=$weighted;$ps[$p['id']]=['score'=>$score,'weighted'=>$weighted,'applicable'=>$app];}
 return ['final'=>$final,'answered'=>$answered,'counts'=>$counts,'critical_findings'=>$critical,'parameters'=>$ps];
}
function show_assessment(int $id){[$assessment,$parameters,$answers]=assessment_data($id);$score=calculate_score($parameters,$answers);$title=$assessment['vendor_name'];ob_start();require __DIR__.'/../views/assessments/show.php';$content=ob_get_clean();require __DIR__.'/../views/layout.php';}
function save_assessment(int $id){ verify_csrf(); [$assessment,$parameters,$answers]=assessment_data($id); $controlId=$_POST['control_id']??''; $control=null;foreach($parameters as $p)foreach($p['controls'] as $c)if($c['id']===$controlId)$control=$c;if(!$control){http_response_code(422);exit('Invalid control');}
 $status=$_POST['status']??'';if(!in_array($status,['Compliant','Partially Compliant','Non-Compliant','N/A'],true)){flash('error','Status tidak valid.');redirect('assessments/'.$id.'#control-'.$controlId);}
 $config=require __DIR__.'/../../config/config.php';$evidencePath=$answers[$controlId]['evidence_path']??null;$evidenceName=$answers[$controlId]['evidence_original_name']??null;
 if(!empty($_FILES['evidence']['name']) && $_FILES['evidence']['error']===UPLOAD_ERR_OK){$allowed=['pdf','png','jpg','jpeg','doc','docx','xls','xlsx','txt'];$ext=strtolower(pathinfo($_FILES['evidence']['name'],PATHINFO_EXTENSION));if(!in_array($ext,$allowed,true)||$_FILES['evidence']['size']>$config['max_upload_mb']*1024*1024){flash('error','Evidence harus berupa file yang diizinkan dan maksimal 10 MB.');redirect('assessments/'.$id.'#control-'.$controlId);} $name=bin2hex(random_bytes(12)).'.'.$ext;$dest=$config['upload_dir'].'/'.$name;if(!is_dir($config['upload_dir']))mkdir($config['upload_dir'],0775,true);move_uploaded_file($_FILES['evidence']['tmp_name'],$dest);$evidencePath=$name;$evidenceName=$_FILES['evidence']['name'];}
 $db=Database::get();$sql='INSERT INTO assessment_answers(assessment_id,control_id,status,evidence_path,evidence_original_name,finding,recommendation,updated_by) VALUES(?,?,?,?,?,?,?,?) ON CONFLICT(assessment_id,control_id) DO UPDATE SET status=excluded.status,evidence_path=COALESCE(excluded.evidence_path,assessment_answers.evidence_path),evidence_original_name=COALESCE(excluded.evidence_original_name,assessment_answers.evidence_original_name),finding=excluded.finding,recommendation=excluded.recommendation,updated_by=excluded.updated_by,updated_at=CURRENT_TIMESTAMP';$db->prepare($sql)->execute([$id,$controlId,$status,$evidencePath,$evidenceName,trim($_POST['finding']??''),trim($_POST['recommendation']??''),current_user()['id']]);
 $db->prepare('INSERT INTO audit_logs(assessment_id,user_id,action,entity_type,entity_id,details) VALUES(?,?,?,?,?,?)')->execute([$id,current_user()['id'],'answer_saved','control',$controlId,json_encode(['status'=>$status])]);
 $done=(int)$db->query('SELECT COUNT(*) FROM controls')->fetchColumn();$stmt=$db->prepare('SELECT COUNT(*) FROM assessment_answers WHERE assessment_id=? AND status IS NOT NULL');$stmt->execute([$id]);$answeredNow=(int)$stmt->fetchColumn();$newStatus=$answeredNow >= $done ? 'Completed' : 'In Progress';$db->prepare('UPDATE assessments SET status=?,updated_at=CURRENT_TIMESTAMP WHERE id=?')->execute([$newStatus,$id]);
 if(isset($_SERVER['HTTP_X_REQUESTED_WITH'])){header('Content-Type: application/json');echo json_encode(['ok'=>true,'message'=>'Saved']);return;}flash('success',$controlId.' tersimpan.');redirect('assessments/'.$id.'#control-'.$controlId); }
function show_report(int $id){[$assessment,$parameters,$answers]=assessment_data($id);$score=calculate_score($parameters,$answers);$rating=$score['final']>=90?'Excellent':($score['final']>=75?'Good':($score['final']>=60?'Needs Improvement':'High Risk'));$db=Database::get();$q=$db->prepare('SELECT c.code control_code,c.question,c.recommendation baseline,aa.finding,aa.recommendation FROM assessment_answers aa JOIN controls c ON c.id=aa.control_id WHERE aa.assessment_id=? AND c.critical=1 AND aa.status IN ("Partially Compliant","Non-Compliant") ORDER BY c.sort_order');$q->execute([$id]);$findings=$q->fetchAll();$q=$db->prepare('SELECT c.code control_code,COALESCE(NULLIF(aa.recommendation,""),c.recommendation) recommendation FROM assessment_answers aa JOIN controls c ON c.id=aa.control_id WHERE aa.assessment_id=? AND aa.status IN ("Partially Compliant","Non-Compliant") ORDER BY c.sort_order');$q->execute([$id]);$recommendations=$q->fetchAll();require __DIR__.'/../views/report/show.php';}
